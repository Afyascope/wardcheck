# WardCheck CMS environment variables
# Copy this file to .env and fill in your values.

# Server
HOST=0.0.0.0
PORT=1338

# Secrets (generate unique values - do not reuse other projects' secrets)
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
# Local development uses SQLite
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production uses PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wardcheck_cms?schema=public
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=wardcheck_cms
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=password
# DATABASE_SSL=false

# Cloudinary media uploads (leave empty to use local media library)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# CORS for the public website that will consume the CMS API
# APP_URLS=http://localhost:5173,https://wardcheck.co.ke
