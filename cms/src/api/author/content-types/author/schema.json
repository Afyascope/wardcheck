{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "WardCheck Author",
    "description": "Authors of WardCheck editorial content."
  },
  "options": {},
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "bio": {
      "type": "text"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "email",
      "private": true
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "author"
    },
    "salaryGuides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::salary-guide.salary-guide",
      "mappedBy": "author"
    },
    "careerGuides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::career-guide.career-guide",
      "mappedBy": "author"
    },
    "workplaceGuides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::workplace-guide.workplace-guide",
      "mappedBy": "author"
    }
  }
}
