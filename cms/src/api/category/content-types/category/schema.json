    },
    "careerGuides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::career-guide.career-guide",
      "mappedBy": "category"
    },
    "workplaceGuides": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::workplace-guide.workplace-guide",
