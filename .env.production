# Production build default. Overridable by a VITE_WARDCHECK_CMS_URL build/CI env var.
# Without this file, `vite build` silently falls back to `.env` (http://localhost:1338),
# baking a localhost CMS URL into the deployed bundle -> "Article unavailable".
VITE_WARDCHECK_CMS_URL=https://keen-balance-production-c25d.up.railway.app